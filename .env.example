# Copy this file to `.env` (git-ignored) before running `make up` /
# `docker compose up`. Every value below is a non-secret local-development
# default — replace them with real secrets for any non-local environment.
#
# See docs/local-dev-stack.md for the full list of services and how these
# variables are wired to them.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=twitter_smart_clone
POSTGRES_PASSWORD=twitter_smart_clone_dev
POSTGRES_DB=twitter_smart_clone
POSTGRES_PORT=5432
# Async SQLAlchemy/SQLModel URL used by the backend/worker containers.
DATABASE_URL=postgresql+asyncpg://twitter_smart_clone:twitter_smart_clone_dev@postgres:5432/twitter_smart_clone

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-compatible object storage) ------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-dev-secret
MINIO_BUCKET=twitter-smart-clone-media
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Reachable from inside backend/worker containers.
MINIO_ENDPOINT=http://minio:9000
# Reachable from the host / browser (presigned URLs are issued with this).
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# --- Backend / API -------------------------------------------------------------
BACKEND_PORT=8000
JWT_SECRET_KEY=dev-only-change-me
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend ------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
